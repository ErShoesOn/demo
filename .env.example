# ---------------------------------------------------------------------------
# Majestic Rentals — environment variables
#
# Copy this file to `.env.local` for local development. Never commit real
# credentials or customer data. On Vercel, add the real values in
# Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Optional. An HTTPS endpoint that accepts a JSON POST for inquiry delivery
# (for example a form service, automation webhook or your own API endpoint).
# When this is empty, the form does NOT claim the inquiry was sent. It shows a
# copyable summary so the visitor can contact the business directly.
INQUIRY_WEBHOOK_URL=

# Optional. Sent as `Authorization: Bearer <token>` when the webhook is called.
INQUIRY_WEBHOOK_TOKEN=

# Note: VERCEL_ENV is set automatically by Vercel. Preview and development
# deployments are marked noindex by the app; do not override it.
